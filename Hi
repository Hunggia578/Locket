/*
 * Locket Gold Unlock - Bản giữ nguyên 100% data gốc
 */

let body = $response.body;

if (body) {
    try {
        let obj = JSON.parse(body);

        if (!obj.entries) {
            obj.entries = {};
        }

        // 1. Kích hoạt cờ Locket Gold & Premium
        obj.entries["purchases_enabled"] = "true";
        obj.entries["purchases_entitlement"] = "Gold";
        obj.entries["gold_member"] = "true";
        obj.entries["gold_membership"] = "true";
        obj.entries["gold_card"] = "true";
        obj.entries["gold_since"] = "true";
        obj.entries["gold_since_badge_enabled"] = "true";
        obj.entries["gold_member_since_enabled"] = "true";
        obj.entries["locket_gold_badge"] = "true";

        // 2. Ép bật Âm thanh, Mic và Video 30s
        obj.entries["gold_max_duration"] = "30.0";
        obj.entries["max_video_duration"] = "30.0";
        obj.entries["longer_video_enabled"] = "true";
        obj.entries["longer_videos_enabled"] = "true";
        obj.entries["video_sound_enabled"] = "true";
        obj.entries["microphone_enabled"] = "true";
        obj.entries["camera_microphone_enabled"] = "true";

        // 3. Mở khóa Khung Widget & Tải ảnh từ thư viện
        obj.entries["camera_roll_preview_enabled"] = "true";
        obj.entries["upload_use_heif_main"] = "true";
        obj.entries["custom_widget_frames_unlocked"] = "true";
        obj.entries["custom_widget_frames_enabled"] = "true";
        obj.entries["widget_frames_unlocked"] = "true";
        obj.entries["widget_frames_enabled"] = "true";
        obj.entries["app_icon_picker"] = "true";

        // 4. Kích hoạt tính năng Chú thích & Nhạc
        obj.entries["captions_enabled"] = "true";
        obj.entries["long_captions"] = "true";
        obj.entries["music_caption_enabled"] = "true";
        // CHÚ Ý: Tuyệt đối không can thiệp vào obj.entries["overlay_items"] để giữ nguyên kho Meme gốc từ Server.

        // 5. Chặn quảng cáo
        obj.entries["history_ads_mode"] = "disabled";
        obj.entries["history_ads_floor_price"] = "0";

        // 6. Mở khóa cổng tính năng (Feature Gates)
        let gates = obj.entries["feature_gates"] ? JSON.parse(obj.entries["feature_gates"]) : {};
        let unlockFeatures = [
            "app_icon_picker", "camera_roll", "camera_theme", "locket_views", 
            "long_captions", "longer_video", "unlimited_friends", "profile_badge", 
            "custom_widget_frames", "longerVideo", "video", "widget_frame", 
            "live_photos", "gold_camera_themes", "gold_badge", "groups"
        ];
        for (let f of unlockFeatures) {
            gates[f] = "enabled";
        }
        gates["remove_ads"] = "subscriber";
        obj.entries["feature_gates"] = JSON.stringify(gates);

        // Bắt buộc app nhận cấu hình
        obj.state = "UPDATE";

        body = JSON.stringify(obj);
    } catch (e) {
        console.log("Locket Script Error: " + e);
    }
}

$done({ body });
